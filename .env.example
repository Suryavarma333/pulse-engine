POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse-local-only
PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse-local-only@postgres:5432/pulse
PULSE_CONTROL_TOKEN=replace-this-for-any-shared-environment
PULSE_METRICS_WINDOW_SECONDS=10
PULSE_NONCRITICAL_RATE_PER_SECOND=2
PULSE_NONCRITICAL_RATE_BURST=4
PULSE_DEMO_APP_BASE_URL=http://demo-app:8000
PULSE_EXECUTION_MODE=dry_run
PULSE_MAX_INSTANCE_CEILING=3
PULSE_MINIMUM_DESIRED_CAPACITY=1
PULSE_SIMULATED_DESIRED_CAPACITY=1
PULSE_METRIC_POLL_SECONDS=2
PULSE_BASELINE_WINDOW_SECONDS=60
PULSE_MINIMUM_SAMPLES=5
PULSE_ACCELERATION_THRESHOLD_RPS2=2
PULSE_ENTRY_RATIO_THRESHOLD=1.5
PULSE_EXIT_RATIO_THRESHOLD=1.15
PULSE_CONFIDENCE_THRESHOLD=0.65
PULSE_CONFIRMATION_COUNT=3
PULSE_RECOVERY_LOW_THRESHOLD_RPS=2
PULSE_RECOVERY_CONFIRMATION_COUNT=3
PULSE_COOLDOWN_SECONDS=120
PULSE_RECOVERY_DECREMENT_STEP=1
PULSE_QUERY_DEFAULT_WINDOW_SECONDS=3600
PULSE_QUERY_MAX_WINDOW_SECONDS=86400
PULSE_QUERY_MAX_ROWS=1000
PULSE_PROVIDER_TIMEOUT_SECONDS=1
PULSE_OPTIONAL_SIGNAL_FRESHNESS_SECONDS=15
