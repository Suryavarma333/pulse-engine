POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse-local-only
PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse-local-only@postgres:5432/pulse
PULSE_CONTROL_TOKEN=replace-this-for-any-shared-environment
PULSE_METRICS_WINDOW_SECONDS=10
PULSE_NONCRITICAL_RATE_PER_SECOND=2
PULSE_NONCRITICAL_RATE_BURST=4
