POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse-local-only
PULSE_DATABASE_URL=postgresql+psycopg://pulse:pulse-local-only@postgres:5432/pulse
PULSE_POSTGRES_PORT=5432
PULSE_DEMO_APP_PORT=8000
PULSE_AGENT_PORT=8100
PULSE_DASHBOARD_PORT=3000
PULSE_POSTGRES_VOLUME=pulse-postgres-data
PULSE_LOG_MAX_SIZE=10m
PULSE_LOG_MAX_FILES=3
PULSE_CONTROL_TOKEN=replace-this-for-any-shared-environment
PULSE_METRICS_WINDOW_SECONDS=10
PULSE_METRICS_MAX_SAMPLES=20000
PULSE_NONCRITICAL_RATE_PER_SECOND=2
PULSE_NONCRITICAL_RATE_BURST=4
PULSE_DEMO_APP_BASE_URL=http://demo-app:8000
PULSE_EXECUTION_MODE=dry_run
# Live mode also requires explicit AWS_REGION and PULSE_ASG_NAME. Never put credentials here.
PULSE_MAX_INSTANCE_CEILING=3
PULSE_MINIMUM_DESIRED_CAPACITY=1
PULSE_SIMULATED_DESIRED_CAPACITY=1
PULSE_METRIC_POLL_SECONDS=2
PULSE_BASELINE_WINDOW_SECONDS=60
PULSE_MINIMUM_SAMPLES=5
PULSE_ACCELERATION_THRESHOLD_RPS2=2
PULSE_ENTRY_RATIO_THRESHOLD=1.5
PULSE_EXIT_RATIO_THRESHOLD=1.15
PULSE_CONFIDENCE_THRESHOLD=0.65
PULSE_CONFIRMATION_COUNT=3
PULSE_RECOVERY_LOW_THRESHOLD_RPS=2
PULSE_RECOVERY_CONFIRMATION_COUNT=3
PULSE_COOLDOWN_SECONDS=120
PULSE_RECOVERY_DECREMENT_STEP=1
PULSE_QUERY_DEFAULT_WINDOW_SECONDS=3600
PULSE_QUERY_MAX_WINDOW_SECONDS=86400
PULSE_QUERY_MAX_ROWS=1000
PULSE_PROVIDER_TIMEOUT_SECONDS=1
PULSE_SHEDDING_CONTROL_TIMEOUT_SECONDS=2
PULSE_RECONCILIATION_MIN_AGE_SECONDS=30
PULSE_RECONCILIATION_BATCH_SIZE=50
PULSE_OPTIONAL_SIGNAL_FRESHNESS_SECONDS=15
PULSE_ORIGIN_SIGNAL_FRESHNESS_SECONDS=10
PULSE_SIGNAL_BUFFER_CAPACITY=1000
PULSE_SIMULATED_SIGNAL_MAX_TTL_SECONDS=300
PULSE_SIMULATED_SIGNAL_FUTURE_TOLERANCE_SECONDS=5
PULSE_REALTIME_WINDOW_MAX_SAMPLES=1000
PULSE_BASELINE_STRATEGY=moving_average
PULSE_EXPONENTIAL_SMOOTHING_ALPHA=0.35
PULSE_REACTIVE_CPU_THRESHOLD_PCT=70
PULSE_REACTIVE_LOAD_THRESHOLD_RPS=50
PULSE_FORECAST_HORIZON_SECONDS=30
PULSE_RPS_PER_INSTANCE=25
PULSE_SCHEDULED_POLL_SECONDS=5
PULSE_SCHEDULED_LOOKAHEAD_SECONDS=86400
PULSE_SCHEDULED_RAMP_STEPS=4
PULSE_NEAR_EVENT_PROTECTION_SECONDS=300
PULSE_FEEDBACK_POLL_SECONDS=5
PULSE_FEEDBACK_HORIZON_SECONDS=30
PULSE_STATUS_CAPACITY_TIMEOUT_SECONDS=2
PULSE_DASHBOARD_ORIGINS=http://localhost:3000
NEXT_PUBLIC_PULSE_API_URL=http://localhost:8100
NEXT_PUBLIC_PULSE_POLL_MS=2000
PULSE_SCENARIO=sudden-spike
PULSE_BASELINE_TYPE=pulse
